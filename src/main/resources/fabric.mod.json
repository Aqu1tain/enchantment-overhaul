{
    "schemaVersion": 1,
    "id": "enchantment-overhaul",
    "version": "${version}",
    "name": "Enchantment Overhaul",
    "description": "Separates enchanting into three distinct systems: Smithing Table for stats, innate material properties, and a reworked Enchanting Table for magic only.",
    "authors": ["Aqu1tain"],
    "contributors": ["LolloNapo"],
    "contact": {
        "sources": "https://github.com/Aqu1tain/enchantment-overhaul"
    },
    "license": "All-Rights-Reserved",
    "icon": "assets/enchantment-overhaul/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["com.akitain.enchantmentoverhaul.EnchantmentOverhaul"],
        "client": ["com.akitain.enchantmentoverhaul.EnchantmentOverhaulClient"]
    },
    "mixins": ["enchantment-overhaul.mixins.json"],
    "depends": {
        "fabricloader": ">=0.18.4",
        "minecraft": "~26.1",
        "java": ">=25",
        "fabric-api": "*"
    }
}
